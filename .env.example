# Run npm run setup to create .env and a random admin password.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATA_DIR=./data
ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
TRUST_PROXY=false

# Optional: create a Zoom meeting automatically when accepting a request.
# Set ALL four values on the SERVER. Never commit credentials.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
