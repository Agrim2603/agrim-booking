{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agrim-consultations",
  "main": "cloudflare/index.mjs",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz", "/booking"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "BOOKING_ROOM", "class_name": "BookingRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BookingRoom"] }],
  "observability": { "enabled": false }
}
