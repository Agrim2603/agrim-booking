{
  "name": "agrim-consultation-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Consultation booking, private notes and live availability. Portable Node.js server with SQLite.",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --watch --env-file-if-exists=.env server/index.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  }
}
